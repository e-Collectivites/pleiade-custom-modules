<?php

/**
 * Implements hook_preprocess_page().
 */
function msg_informatif_pleiade_preprocess_page(&$variables) {
  $variables['#attached']['library'][] = 'msg_informatif_pleiade/msg_informatif_pleiade_css';
  $variables['#attached']['library'][] = 'msg_informatif_pleiade/msg_informatif_pleiade_js';
}