(function ($, Drupal, drupalSettings, once) {
  "use strict";

  Drupal.behaviors.CirilProductsBehavior = {
    attach: function (context, settings) {
      once("CirilProductsBehavior", "#ciril_tickets_id", context).forEach(function (element) {
        const container = element;
        if (!container) return;

        container.innerHTML = '<div class="text-center p-3"><span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Chargement des données...</div>';

        const apiUrl = "https://pleiade-test.sitiv.fr/v1/api_ciril_pleiade/batch-counts";

        fetch(apiUrl)
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            return response.json();
          })
          .then((data) => {
            
              let itemsHTML = `

                <div class="card mb-3 close" data-id="products">
                  <div class="card-header close-icon rounded-top bg-white border-bottom d-flex">
                    <h4 class="card-title text-dark mb-0 py-2">Cartes Ciril (en développement)</h4>
                    <button class="close-button">×</button>
                  </div>
                  <div class="card-body close-div">
                    <div class="row g-3">
              `;

            if (Array.isArray(data) && data.length > 0) {
              data.forEach((item) => {
                const labelParts = item.label.split('\n');
                const mainTitle = labelParts[0]; 
                const subTitle = labelParts.slice(1).join('<br>');

                itemsHTML += `
                  <div class="col-md-3">
                    <div class="border rounded p-3 bg-light d-flex flex-column justify-content-between shadow-sm h-100">
                      
                      <div class="mb-2">
                        <h6 class="fw-bold text-dark">${mainTitle}</h6>
                        <div class="text-muted small" style="line-height: 1.2;">${subTitle}</div>
                      </div>

                      <div class="text-end mt-3">
                        <span class="fw-bold ${item.count > 0 ? 'text-primary' : 'text-secondary'}" style="font-size: 2.5rem; line-height: 1;">
                          ${item.count}
                        </span>
                      </div>

                    </div>
                  </div>
                `;
              });
            } else {
               itemsHTML += `<div class="col-12"><p class="text-muted">Aucune donnée à afficher.</p></div>`;
            }

            itemsHTML += `
                  </div>
                </div>
              </div>
            `;

            container.innerHTML = itemsHTML;

          })
          .catch((error) => {
            console.error("Erreur API Ciril:", error);
            container.innerHTML = `
              <div class="alert alert-danger" role="alert">
                Impossible de charger les données Ciril.
              </div>`;
          });
      });
    },
  };
})(jQuery, Drupal, drupalSettings, once);